---
import Seo from '../components/Seo.astro';
import type { JsonLdNode } from '../lib/seo';
import '../styles/home/styles.css';
import '../styles/home/craft.css';
import '../styles/home/feedback.css';

interface Props {
	title: string;
	description: string;
	extraGraph?: JsonLdNode[];
}

const { title, description, extraGraph = [] } = Astro.props;
---

<!doctype html>
<html lang="es-MX">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="theme-color" content="#F7F6F3" />
		<meta name="generator" content={Astro.generator} />
		<Seo title={title} description={description} extraGraph={extraGraph} />
		<script is:inline>
			document.documentElement.classList.add('js');
		</script>
		<link rel="preload" href="/fonts/instrument-sans.woff2" as="font" type="font/woff2" crossorigin />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/favicon-180.png" />
	</head>
	<body>
		<slot />
		<script src="../scripts/home-motion.js"></script>
	</body>
</html>
