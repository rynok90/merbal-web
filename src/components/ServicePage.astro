---
import CtaBand from './CtaBand.astro';

interface Point {
	title: string;
	body: string;
}

interface Props {
	eyebrow: string;
	title: string;
	lead: string;
	points: Point[];
}

const { eyebrow, title, lead, points } = Astro.props;
---

<main>
	<section class="relative overflow-hidden bg-navy-950 pt-[4.25rem]">
		<div
			class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_40%_at_50%_-10%,rgba(43,140,255,0.16),transparent_58%)]"
		>
		</div>
		<div class="relative mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
			<p class="hero-in mb-4 font-display text-xs font-medium uppercase tracking-[0.22em] text-accent">
				{eyebrow}
			</p>
			<h1 class="hero-in max-w-3xl font-display text-4xl font-semibold tracking-tight sm:text-5xl">
				{title}
			</h1>
			<p class="hero-in mt-6 max-w-2xl text-base leading-relaxed text-text-soft sm:text-lg">
				{lead}
			</p>
		</div>
	</section>

	<section class="border-t border-white/5 bg-navy-900 py-16 sm:py-24">
		<div class="mx-auto grid w-full max-w-6xl gap-5 px-5 sm:px-8 md:grid-cols-2">
			{
				points.map((point) => (
					<article class="card-hover rounded-2xl border border-white/10 bg-navy-950 p-6 sm:p-8" data-reveal>
						<h2 class="font-display text-xl font-semibold">{point.title}</h2>
						<p class="mt-3 text-sm leading-relaxed text-muted">{point.body}</p>
					</article>
				))
			}
		</div>
	</section>

	<CtaBand />
</main>
