---
import { CONTACT_PATH, HEADER_CTA_LABEL, HEADER_NAV, isActivePath } from '../lib/nav';

const path = Astro.url.pathname;
---

<header
	id="site-header"
	class="site-header fixed inset-x-0 top-0 z-50 border-b backdrop-blur-md"
	data-scrolled="false"
>
	<div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-accent to-transparent"></div>
	<div class="mx-auto flex h-[4.25rem] w-full max-w-6xl items-center justify-between gap-4 px-5 sm:px-8">
		<a href="/" class="flex items-center gap-2.5 text-text">
			<img src="/images/logo-mark.png" alt="MERBAL" class="h-8 w-8 object-contain" />
			<span class="font-display text-[0.8rem] font-semibold tracking-[0.2em]">MERBAL</span>
		</a>

		<nav class="hidden items-center gap-5 xl:gap-6 lg:flex" aria-label="Principal">
			{
				HEADER_NAV.map((link) =>
					link.children ? (
						<div class="nav-item-dropdown relative">
							<a
								href={link.href}
								class:list={[
									'nav-link text-sm',
									isActivePath(path, link.href) ? 'is-active text-text' : 'text-muted',
								]}
								aria-current={isActivePath(path, link.href) ? 'page' : undefined}
								aria-haspopup="true"
							>
								{link.label}
							</a>
							<div class="nav-dropdown" role="menu">
								{
									link.children.map((child) => (
										<a
											href={child.href}
											class:list={[
												'block rounded-lg px-3 py-2 text-sm transition-colors',
												isActivePath(path, child.href)
													? 'bg-navy-800 text-text'
													: 'text-text-soft hover:bg-navy-800 hover:text-text',
											]}
											role="menuitem"
										>
											{child.label}
										</a>
									))
								}
							</div>
						</div>
					) : (
						<a
							href={link.href}
							class:list={['nav-link text-sm', isActivePath(path, link.href) ? 'is-active text-text' : 'text-muted']}
							aria-current={isActivePath(path, link.href) ? 'page' : undefined}
						>
							{link.label}
						</a>
					),
				)
			}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href={CONTACT_PATH}
				class="btn-primary hidden rounded-full bg-accent px-4 py-2 font-display text-sm font-semibold text-navy-950 sm:inline-flex"
			>
				{HEADER_CTA_LABEL}
			</a>
			<button
				id="nav-toggle"
				type="button"
				class="inline-flex h-10 w-10 items-center justify-center rounded-full border border-white/10 text-text transition-transform duration-200 hover:scale-105 lg:hidden"
				aria-controls="nav-panel"
				aria-expanded="false"
				aria-label="Abrir menú"
			>
				<span class="sr-only">Menú</span>
				<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
					<path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
	</div>

	<div
		id="nav-panel"
		class="hidden border-t border-white/5 bg-navy-900 px-5 py-4 lg:hidden"
		data-open="false"
	>
		<nav class="flex flex-col gap-1" aria-label="Móvil">
			{
				HEADER_NAV.map((link) => (
					<>
						<a
							href={link.href}
							class:list={[
								'rounded-lg px-3 py-2.5 text-sm transition-colors',
								isActivePath(path, link.href) ? 'bg-navy-800 text-text' : 'text-text-soft hover:bg-navy-800 hover:text-text',
							]}
							aria-current={isActivePath(path, link.href) ? 'page' : undefined}
						>
							{link.label}
						</a>
						{link.children?.map((child) => (
							<a
								href={child.href}
								class:list={[
									'rounded-lg py-2.5 pr-3 pl-6 text-sm transition-colors',
									isActivePath(path, child.href)
										? 'bg-navy-800 text-text'
										: 'text-muted hover:bg-navy-800 hover:text-text',
								]}
								aria-current={isActivePath(path, child.href) ? 'page' : undefined}
							>
								{child.label}
							</a>
						))}
					</>
				))
			}
			<a
				href={CONTACT_PATH}
				class="btn-primary mt-2 rounded-full bg-accent px-4 py-2.5 text-center font-display text-sm font-semibold text-navy-950"
			>
				{HEADER_CTA_LABEL}
			</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById('nav-toggle');
	const panel = document.getElementById('nav-panel');

	function setOpen(open: boolean) {
		if (!toggle || !panel) return;
		panel.classList.toggle('hidden', !open);
		panel.dataset.open = String(open);
		toggle.setAttribute('aria-expanded', String(open));
		toggle.setAttribute('aria-label', open ? 'Cerrar menú' : 'Abrir menú');
	}

	toggle?.addEventListener('click', () => {
		setOpen(panel?.dataset.open !== 'true');
	});
</script>
