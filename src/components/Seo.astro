---
import {
	OG_IMAGE,
	OG_IMAGE_ALT,
	baseGraph,
	canonicalFor,
	jsonLd,
	type JsonLdNode,
} from '../lib/seo';

interface Props {
	title: string;
	description: string;
	extraGraph?: JsonLdNode[];
}

const { title, description, extraGraph = [] } = Astro.props;
const canonical = canonicalFor(Astro.url.pathname);
const graph = jsonLd(baseGraph(extraGraph));
---

<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={OG_IMAGE} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={OG_IMAGE_ALT} />
<meta property="og:url" content={canonical} />
<meta property="og:type" content="website" />
<meta property="og:locale" content="es_MX" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={OG_IMAGE} />
<meta name="twitter:image:alt" content={OG_IMAGE_ALT} />
<script is:inline type="application/ld+json" set:html={graph} />
<title>{title}</title>
