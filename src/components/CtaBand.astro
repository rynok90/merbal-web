---
import { CONTACT_PATH } from '../lib/nav';

interface Props {
	title?: string;
	lead?: string;
	label?: string;
}

const {
	title = 'Hablemos de tu operación.',
	lead = 'Un especialista responde. Sin catálogo de entrada.',
	label = 'Solicitar asesoría',
} = Astro.props;
---

<section class="border-t border-white/5 bg-navy-900 py-16 sm:py-20">
	<div class="mx-auto flex w-full max-w-6xl flex-col items-start justify-between gap-6 px-5 sm:px-8 lg:flex-row lg:items-center">
		<div data-reveal>
			<h2 class="font-display text-2xl font-semibold tracking-tight sm:text-3xl">{title}</h2>
			<p class="mt-2 text-sm text-muted sm:text-base">{lead}</p>
		</div>
		<a
			href={CONTACT_PATH}
			class="btn-primary inline-flex items-center justify-center rounded-full bg-accent px-6 py-3 font-display text-sm font-semibold text-navy-950"
			data-reveal
		>
			{label}
		</a>
	</div>
</section>
