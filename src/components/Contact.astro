---
import {
	CONTACT_FUNCTION_PATH,
	DIVISIONS,
	VERTICALS,
} from '../lib/contact-config';
import { CONTACT_EMAIL } from '../lib/mailto';
---

<section class="border-t border-white/5 bg-navy-950 py-20 sm:py-28">
	<div class="mx-auto grid w-full max-w-6xl gap-12 px-5 sm:px-8 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16">
		<div data-reveal>
			<p class="mb-3 font-display text-xs font-medium uppercase tracking-[0.22em] text-accent">Contacto</p>
			<h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">
				Pide una demo o una asesoría.
			</h2>
			<p class="mt-4 text-base text-text-soft sm:text-lg">
				Cuéntanos la división, el sitio o el sistema. Un especialista te responde. Sin abrir el correo.
			</p>
			<a
				href={`mailto:${CONTACT_EMAIL}`}
				class="mt-8 inline-flex items-center gap-2 text-sm text-accent transition-colors hover:text-accent-2"
			>
				{CONTACT_EMAIL}
			</a>
		</div>

		<form
			id="contact-form"
			class="rounded-2xl border border-white/10 bg-navy-900 p-6 sm:p-8"
			method="post"
			action={CONTACT_FUNCTION_PATH}
			data-reveal
		>
			<div class="grid gap-5 sm:grid-cols-2">
				<label class="grid gap-2 text-sm text-text-soft sm:col-span-1">
					Nombre
					<input
						id="nombre"
						type="text"
						name="nombre"
						autocomplete="name"
						required
						class="rounded-lg border border-white/10 bg-navy-950 px-3.5 py-2.5 text-text outline-none transition focus:border-accent"
					/>
				</label>
				<label class="grid gap-2 text-sm text-text-soft sm:col-span-1">
					Email
					<input
						id="email"
						type="email"
						name="email"
						autocomplete="email"
						required
						class="rounded-lg border border-white/10 bg-navy-950 px-3.5 py-2.5 text-text outline-none transition focus:border-accent"
					/>
				</label>
				<label class="grid gap-2 text-sm text-text-soft sm:col-span-2">
					Empresa
					<input
						id="empresa"
						type="text"
						name="empresa"
						autocomplete="organization"
						class="rounded-lg border border-white/10 bg-navy-950 px-3.5 py-2.5 text-text outline-none transition focus:border-accent"
					/>
				</label>
				<label class="grid gap-2 text-sm text-text-soft sm:col-span-2">
					División
					<select
						id="division"
						name="division"
						required
						class="rounded-lg border border-white/10 bg-navy-950 px-3.5 py-2.5 text-text outline-none transition focus:border-accent"
					>
						<option value="">Elige una división</option>
						{DIVISIONS.map((division) => <option value={division}>{division}</option>)}
					</select>
				</label>
				<label id="vertical-field" class="grid gap-2 text-sm text-text-soft sm:col-span-2" hidden>
					Vertical
					<select
						id="vertical"
						name="vertical"
						class="rounded-lg border border-white/10 bg-navy-950 px-3.5 py-2.5 text-text outline-none transition focus:border-accent"
					>
						<option value="">Elige una vertical</option>
						{VERTICALS.map((vertical) => <option value={vertical}>{vertical}</option>)}
					</select>
				</label>
				<label class="grid gap-2 text-sm text-text-soft sm:col-span-2">
					Mensaje
					<textarea
						id="mensaje"
						name="mensaje"
						rows="5"
						required
						class="resize-y rounded-lg border border-white/10 bg-navy-950 px-3.5 py-2.5 text-text outline-none transition focus:border-accent"
					></textarea>
				</label>
				<label class="sr-only" aria-hidden="true">
					Sitio web
					<input type="text" name="website" tabindex="-1" autocomplete="off" />
				</label>
			</div>
			<p id="contact-status" class="mt-4 hidden text-sm text-text-soft" role="status"></p>
			<button
				id="contact-submit"
				type="submit"
				class="btn-primary mt-6 inline-flex w-full items-center justify-center rounded-full bg-accent px-6 py-3 font-display text-sm font-semibold text-navy-950 sm:w-auto"
			>
				Pedir demo o asesoría
			</button>
		</form>
	</div>
</section>

<script>
	import { CONTACT_FUNCTION_PATH } from '../lib/contact-config';

	const form = document.getElementById('contact-form');
	const division = document.getElementById('division');
	const vertical = document.getElementById('vertical');
	const verticalField = document.getElementById('vertical-field');
	const statusEl = document.getElementById('contact-status');
	const submit = document.getElementById('contact-submit');

	function setVerticalVisible(show: boolean) {
		if (!(verticalField instanceof HTMLElement) || !(vertical instanceof HTMLSelectElement)) return;
		verticalField.hidden = !show;
		vertical.required = show;
		if (!show) vertical.value = '';
	}

	function showStatus(message: string, ok: boolean) {
		if (!(statusEl instanceof HTMLElement)) return;
		statusEl.textContent = message;
		statusEl.classList.remove('hidden');
		statusEl.classList.toggle('text-accent', ok);
		statusEl.classList.toggle('text-text-soft', !ok);
	}

	division?.addEventListener('change', () => {
		const value = division instanceof HTMLSelectElement ? division.value : '';
		setVerticalVisible(value === 'Plataformas');
	});

	form?.addEventListener('submit', async (event) => {
		event.preventDefault();
		if (!(form instanceof HTMLFormElement)) return;
		const data = new FormData(form);
		const payload = {
			nombre: String(data.get('nombre') ?? '').trim(),
			email: String(data.get('email') ?? '').trim(),
			empresa: String(data.get('empresa') ?? '').trim(),
			mensaje: String(data.get('mensaje') ?? '').trim(),
			division: String(data.get('division') ?? '').trim(),
			vertical: String(data.get('vertical') ?? '').trim(),
			website: String(data.get('website') ?? '').trim(),
		};

		if (submit instanceof HTMLButtonElement) submit.disabled = true;
		showStatus('Enviando…', false);

		try {
			const response = await fetch(CONTACT_FUNCTION_PATH, {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: JSON.stringify(payload),
			});
			const body = await response.json().catch(() => ({}));
			if (response.ok && body?.ok) {
				form.reset();
				setVerticalVisible(false);
				showStatus('Recibimos tu mensaje. Un especialista te responde.', true);
			} else {
				showStatus('No se pudo enviar. Inténtalo de nuevo.', false);
			}
		} catch {
			showStatus('No se pudo enviar. Inténtalo de nuevo.', false);
		} finally {
			if (submit instanceof HTMLButtonElement) submit.disabled = false;
		}
	});
</script>
