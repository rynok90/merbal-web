---
import CtaBand from './CtaBand.astro';

interface Props {
	title: string;
	sub: string;
	intro: string;
	layers: string[];
	audience: string;
	method: string;
}

const { title, sub, intro, layers, audience, method } = Astro.props;
const steps = method.split('→').map((step) => step.trim()).filter(Boolean);
---

<main>
	<section class="relative overflow-hidden bg-navy-950 pt-[4.25rem]">
		<div
			class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_40%_at_50%_-10%,rgba(43,140,255,0.16),transparent_58%)]"
		>
		</div>
		<div class="relative mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
			<p class="badge-integration hero-in mb-4">Integración</p>
			<h1 class="hero-in max-w-3xl font-display text-4xl font-semibold tracking-tight sm:text-5xl">
				{title}
			</h1>
			<p class="hero-in mt-6 max-w-2xl text-base leading-relaxed text-text-soft sm:text-lg">
				{sub}
			</p>
			<div class="hero-in mt-8 h-px w-16 bg-[#F5A524]" aria-hidden="true"></div>
		</div>
	</section>

	<section class="border-t border-white/5 bg-navy-900 py-16 sm:py-24">
		<div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
			<p class="max-w-3xl text-base leading-relaxed text-text-soft sm:text-lg">{intro}</p>
			<h2 class="mt-12 font-display text-xs font-medium uppercase tracking-[0.18em] text-accent">Capas</h2>
			<ul class="mt-5 flex flex-wrap gap-3">
				{
					layers.map((layer) => (
						<li class="inline-flex max-w-full items-center gap-2 rounded-full border border-accent/30 bg-navy-950 px-4 py-2 text-sm text-text">
							<span class="h-1.5 w-1.5 shrink-0 rounded-full bg-[#F5A524]" aria-hidden="true" />
							<span class="min-w-0">{layer}</span>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="border-t border-white/5 bg-navy-950 py-16 sm:py-24">
		<div class="mx-auto grid w-full max-w-6xl gap-5 px-5 sm:px-8 md:grid-cols-2">
			<article class="card-hover min-w-0 rounded-2xl border border-white/10 bg-navy-900 p-6 sm:p-8" data-reveal>
				<h2 class="font-display text-xs font-medium uppercase tracking-[0.18em] text-accent">Para quién</h2>
				<p class="mt-3 text-sm leading-relaxed text-text-soft sm:text-base">{audience}</p>
			</article>
			<article class="card-hover min-w-0 rounded-2xl border border-white/10 bg-navy-900 p-6 sm:p-8" data-reveal>
				<h2 class="font-display text-xs font-medium uppercase tracking-[0.18em] text-accent">Cómo opera</h2>
				<p class="mt-3 text-sm leading-relaxed text-text-soft sm:text-base">{method}</p>
				<ol class="mt-6 grid gap-4">
					{
						steps.map((step, index) => (
							<li class="flex min-w-0 items-start gap-3">
								<span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-accent/40 bg-navy-950 font-display text-xs font-semibold text-accent">
									{String(index + 1).padStart(2, '0')}
								</span>
								<span class="min-w-0 pt-1 text-sm leading-relaxed text-text">{step}</span>
							</li>
						))
					}
				</ol>
			</article>
		</div>
	</section>

	<CtaBand title="¿Esta capa te toca?" lead="Cuéntanos el sitio. Un especialista responde." />
</main>
