---
import { FAQS } from '../../lib/faq';
---

<section class="faq" id="preguntas">
	<div class="wrap">
		<p class="kicker">Preguntas frecuentes</p>
		<h2>Qué es MERBAL y para quién.</h2>
		<div class="faq-list">
			{
				FAQS.map((item) => (
					<article class="faq-item">
						<h3>{item.question}</h3>
						<p>{item.answer}</p>
					</article>
				))
			}
		</div>
	</div>
</section>
