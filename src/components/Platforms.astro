---
import { customSoftware, liveProductHref, productCtaLabel, products } from '../lib/products';

const featured = products.filter((product) => product.status === 'live');
const upcoming = products.filter((product) => product.status === 'soon');
---

<section class="relative overflow-hidden border-t border-white/5 bg-navy-950 py-16 sm:py-24">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_45%_at_80%_0%,rgba(43,140,255,0.14),transparent_60%)]"
	>
	</div>
	<div class="relative mx-auto w-full max-w-6xl px-5 sm:px-8">
		<div class="max-w-2xl" data-reveal>
			<p class="mb-3 font-display text-xs font-medium uppercase tracking-[0.22em] text-accent">
				Productos
			</p>
			<h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">En operación y en camino</h2>
			<p class="mt-4 text-base text-text-soft sm:text-lg">
				Productos propios y desarrollo a la medida para resolver problemas reales y automatizar procesos de operación.
			</p>
		</div>

		{
			featured.map((product) => {
				const href = liveProductHref(product);
				return (
					<article
						class="card-hover group mt-14 rounded-3xl border border-accent/25 bg-navy-900 p-7 sm:p-10"
						data-reveal
					>
						<div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
							<div class="max-w-2xl">
								<p class="font-display text-xs font-medium uppercase tracking-[0.2em] text-accent">
									Producto en operación
								</p>
								<h3 class="mt-3 font-display text-3xl font-semibold sm:text-4xl">{product.name}</h3>
								<p class="mt-4 text-base leading-relaxed text-text-soft">{product.description}</p>
							</div>
							{
								href ? (
									<a
										href={href}
										target="_blank"
										rel="noopener noreferrer"
										class="btn-primary inline-flex shrink-0 items-center justify-center gap-2 rounded-full bg-accent px-6 py-3 font-display text-sm font-semibold text-navy-950"
									>
										{productCtaLabel(product)}
										<svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
											<path d="M7 17 17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round"></path>
										</svg>
									</a>
								) : null
							}
						</div>
					</article>
				);
			})
		}

		<ul class="mt-5 grid gap-5 md:grid-cols-2">
			{
				upcoming.map((product, i) => (
					<li
						class="card-hover rounded-2xl border border-white/10 bg-navy-900/80 p-6 sm:p-8"
						data-reveal
						style={`--reveal-delay: ${i * 90}ms`}
					>
						<div class="flex items-center justify-between gap-3">
							<h3 class="font-display text-xl font-semibold">{product.name}</h3>
							<span class="rounded-full border border-white/10 bg-navy-950 px-3 py-1 font-display text-[0.7rem] font-medium uppercase tracking-[0.16em] text-muted">
								Próximamente
							</span>
						</div>
						<p class="mt-3 text-sm leading-relaxed text-muted">{product.description}</p>
					</li>
				))
			}
		</ul>

		<article
			class="card-hover mt-5 rounded-2xl border border-white/10 bg-navy-900 p-6 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-8"
			data-reveal
			style="--reveal-delay: 120ms"
		>
			<div class="max-w-xl">
				<h3 class="font-display text-xl font-semibold sm:text-2xl">{customSoftware.name}</h3>
				<p class="mt-3 text-sm leading-relaxed text-muted">{customSoftware.description}</p>
			</div>
			<a
				href={customSoftware.href}
				class="btn-secondary mt-5 inline-flex shrink-0 items-center justify-center rounded-full border border-white/15 px-5 py-2.5 font-display text-sm font-medium text-text sm:mt-0"
			>
				Platicar del proyecto
			</a>
		</article>
	</div>
</section>
