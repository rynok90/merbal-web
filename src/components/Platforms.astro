---
import { customSoftware, productStatusLabel, showcaseCta, showcaseProducts } from '../lib/products';

const icons: Record<string, string> = {
	'Access Paperless':
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="4" y="3" width="16" height="18" rx="2"/><path d="M8 8h3v3H8zM13 8h3M13 11h3M8 14h8M8 17h5" stroke-linecap="round"/></svg>',
	'Access Enterprise':
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="9" cy="9" r="3"/><path d="M3.5 19c.6-2.6 2.8-4 5.5-4s4.9 1.4 5.5 4" stroke-linecap="round"/><circle cx="17" cy="9" r="2.2"/><path d="M16.2 15c2.2.3 3.8 1.5 4.3 4" stroke-linecap="round"/></svg>',
	'Safe Access':
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 5 6v6c0 4.2 2.8 7.2 7 8.5 4.2-1.3 7-4.3 7-8.5V6l-7-3Z"/><path d="m9 12 2 2 4-4" stroke-linecap="round" stroke-linejoin="round"/></svg>',
	ActivoObra:
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M12 3 20 7.5v9L12 21 4 16.5v-9L12 3Z"/><path d="M12 12 20 7.5M12 12v9M12 12 4 7.5" stroke-linejoin="round"/></svg>',
	'SecureFlow CRM':
		'<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="6" cy="7" r="2.2"/><circle cx="18" cy="8" r="2.2"/><circle cx="12" cy="17" r="2.2"/><path d="M8 8.2 16 8M7.4 8.8l3.4 6.2M16.4 9.6 13.4 15.2" stroke-linecap="round"/></svg>',
};

const catalog = showcaseProducts();
---

<section class="platform-board relative overflow-x-clip border-t border-white/5 bg-navy-950 py-16 sm:py-24">
	<div
		class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_45%_at_80%_0%,rgba(43,140,255,0.14),transparent_60%)]"
	>
	</div>
	<div class="relative mx-auto w-full max-w-6xl px-5 sm:px-8">
		<div class="max-w-2xl" data-reveal>
			<p class="mb-3 font-display text-xs font-medium uppercase tracking-[0.22em] text-accent">Plataformas</p>
			<h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">Software que ya opera, y el que viene.</h2>
			<p class="mt-4 text-base text-text-soft sm:text-lg">
				Abre una ficha para ver el problema, para quién es y cómo opera.
			</p>
		</div>

		<ul class="platform-grid mt-12 grid gap-6 sm:grid-cols-2 xl:grid-cols-3">
			{
				catalog.map((product) => {
					const action = showcaseCta(product);
					const status = productStatusLabel(product);
					return (
						<li class="min-w-0">
							<article class="platform-card" data-platform-card>
								<span class="platform-card-layer" aria-hidden="true"></span>
								<span class="platform-card-layer platform-card-layer-2" aria-hidden="true"></span>
								<div class="platform-card-body">
									<button
										type="button"
										class="platform-card-face"
										data-platform-open
										data-name={product.name}
										data-status={status}
										data-problem={product.problem}
										data-audience={product.audience}
										data-how={product.howItWorks}
										data-cta-label={action.label}
										data-cta-href={action.href}
										data-cta-external={action.external ? 'true' : 'false'}
										aria-haspopup="dialog"
										aria-controls="platform-panel"
									>
										<span class="flex w-full items-start justify-between gap-3">
											<span class="platform-icon" set:html={icons[product.name] ?? icons['Access Paperless']} />
											<span
												class:list={[
													'rounded-full border px-3 py-1 font-display text-[0.68rem] font-medium uppercase tracking-[0.14em]',
													product.status === 'live'
														? 'border-accent/40 bg-navy-950 text-accent'
														: 'border-white/15 bg-navy-950 text-muted',
												]}
											>
												{status}
											</span>
										</span>
										<span class="font-display text-xl font-semibold text-text">{product.name}</span>
										<span class="text-sm leading-relaxed text-muted">{product.description}</span>
									</button>
									<div class="platform-card-actions">
										<a
											href={action.href}
											class="btn-primary inline-flex items-center justify-center rounded-full bg-accent px-4 py-2 font-display text-sm font-semibold text-navy-950"
											target={action.external ? '_blank' : undefined}
											rel={action.external ? 'noopener noreferrer' : undefined}
										>
											{action.label}
										</a>
									</div>
								</div>
							</article>
						</li>
					);
				})
			}
		</ul>

		<article
			class="card-hover mt-8 rounded-2xl border border-white/10 bg-navy-900 p-6 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-8"
			data-reveal
		>
			<div class="max-w-xl">
				<h3 class="font-display text-xl font-semibold sm:text-2xl">{customSoftware.name}</h3>
				<p class="mt-3 text-sm leading-relaxed text-muted">{customSoftware.description}</p>
			</div>
			<a
				href={customSoftware.href}
				class="btn-secondary mt-5 inline-flex shrink-0 items-center justify-center rounded-full border border-white/15 px-5 py-2.5 font-display text-sm font-medium text-text sm:mt-0"
			>
				Platicar del proyecto
			</a>
		</article>
	</div>

	<dialog id="platform-panel" class="platform-panel" aria-labelledby="platform-panel-title">
		<div class="flex items-start justify-between gap-4">
			<div class="min-w-0">
				<p class="font-display text-xs font-medium uppercase tracking-[0.16em] text-accent" data-panel-status></p>
				<h2 id="platform-panel-title" class="mt-2 font-display text-2xl font-semibold" data-panel-title></h2>
			</div>
			<button type="button" class="platform-panel-close" data-panel-close aria-label="Cerrar">
				Cerrar
			</button>
		</div>
		<div class="mt-6 grid gap-5">
			<section>
				<h3 class="font-display text-xs font-medium uppercase tracking-[0.18em] text-accent">Problema</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-soft" data-panel-problem></p>
			</section>
			<section>
				<h3 class="font-display text-xs font-medium uppercase tracking-[0.18em] text-accent">Para quién</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-soft" data-panel-audience></p>
			</section>
			<section>
				<h3 class="font-display text-xs font-medium uppercase tracking-[0.18em] text-accent">Cómo opera</h3>
				<p class="mt-2 text-sm leading-relaxed text-text-soft" data-panel-how></p>
			</section>
		</div>
		<a
			data-panel-cta
			href="/contacto"
			class="btn-primary mt-6 inline-flex items-center justify-center rounded-full bg-accent px-5 py-2.5 font-display text-sm font-semibold text-navy-950"
		>
			Avisarme
		</a>
	</dialog>
</section>

<script>
	const dialog = document.getElementById('platform-panel');
	const title = dialog?.querySelector('[data-panel-title]');
	const status = dialog?.querySelector('[data-panel-status]');
	const problem = dialog?.querySelector('[data-panel-problem]');
	const audience = dialog?.querySelector('[data-panel-audience]');
	const how = dialog?.querySelector('[data-panel-how]');
	const cta = dialog?.querySelector('[data-panel-cta]');

	function openFrom(button: HTMLButtonElement) {
		if (!(dialog instanceof HTMLDialogElement)) return;
		if (title) title.textContent = button.dataset.name ?? '';
		if (status) status.textContent = button.dataset.status ?? '';
		if (problem) problem.textContent = button.dataset.problem ?? '';
		if (audience) audience.textContent = button.dataset.audience ?? '';
		if (how) how.textContent = button.dataset.how ?? '';
		if (cta instanceof HTMLAnchorElement) {
			cta.textContent = button.dataset.ctaLabel ?? 'Avisarme';
			cta.href = button.dataset.ctaHref ?? '/contacto';
			if (button.dataset.ctaExternal === 'true') {
				cta.target = '_blank';
				cta.rel = 'noopener noreferrer';
			} else {
				cta.removeAttribute('target');
				cta.removeAttribute('rel');
			}
		}
		if (!dialog.open) dialog.showModal();
	}

	document.querySelectorAll('[data-platform-open]').forEach((node) => {
		node.addEventListener('click', () => {
			if (node instanceof HTMLButtonElement) openFrom(node);
		});
	});

	dialog?.querySelector('[data-panel-close]')?.addEventListener('click', () => {
		if (dialog instanceof HTMLDialogElement) dialog.close();
	});

	dialog?.addEventListener('click', (event) => {
		if (event.target === dialog && dialog instanceof HTMLDialogElement) dialog.close();
	});
</script>
