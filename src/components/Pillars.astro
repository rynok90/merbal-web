---
import { PLATFORM_VERTICALS } from '../lib/products';
---

<section id="pilares" class="border-t border-white/5 bg-navy-900 py-20 sm:py-24">
	<div class="mx-auto w-full max-w-6xl px-5 sm:px-8">
		<div class="max-w-2xl" data-reveal>
			<p class="mb-3 font-display text-xs font-medium uppercase tracking-[0.22em] text-accent">Plataformas</p>
			<h2 class="font-display text-3xl font-semibold tracking-tight sm:text-4xl">Plataformas</h2>
			<p class="mt-4 text-base text-text-soft sm:text-lg">
				Dos puertas. Elige la que te toca.
			</p>
		</div>

		<ul class="mt-12 grid gap-5 md:grid-cols-2">
			{
				PLATFORM_VERTICALS.map((vertical) => (
					<li data-reveal>
						<a
							href={vertical.href}
							class="card-hover group flex h-full flex-col rounded-2xl border border-white/10 bg-navy-950 p-7 sm:p-8"
						>
							<h3 class="font-display text-2xl font-semibold">{vertical.name}</h3>
							<p class="mt-3 flex-1 text-sm leading-relaxed text-muted">{vertical.audience}</p>
							<span class="mt-5 font-display text-sm font-medium text-accent group-hover:text-accent-2">
								Ver {vertical.name.toLowerCase()} →
							</span>
						</a>
					</li>
				))
			}
		</ul>
	</div>
</section>
