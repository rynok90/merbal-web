---
import CtaBand from '../components/CtaBand.astro';
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Pillars from '../components/Pillars.astro';

const title = 'MERBAL Technologies — Desarrollamos el software. Integramos la tecnología.';
const description =
	'División de software, Seguridad electrónica e Infraestructura de red. Productos propios y desarrollo a la medida.';
---

<Layout title={title} description={description}>
	<main>
		<Hero />
		<Pillars />
		<CtaBand title="¿Por dónde empezamos?" lead="Un diagnóstico corto. Una arquitectura que se puede defender." />
	</main>
</Layout>
