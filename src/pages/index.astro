---
import CtaBand from '../components/CtaBand.astro';
import Hero from '../components/Hero.astro';
import Layout from '../layouts/Layout.astro';
import Pillars from '../components/Pillars.astro';

const title = 'MERBAL Technologies — Expertise en campo. Productos que operan.';
const description =
	'Empresa mexicana con tres divisiones: seguridad electrónica, infraestructura de red y plataformas.';
---

<Layout title={title} description={description}>
	<main>
		<Hero />
		<Pillars />
		<CtaBand title="¿Por dónde empezamos?" lead="Un diagnóstico corto. Una arquitectura que se puede defender." />
	</main>
</Layout>
