---
import Layout from '../layouts/Layout.astro';
import ServicePage from '../components/ServicePage.astro';
---

<Layout
	title="Infraestructura de red — MERBAL Technologies"
	description="Servicio experto de infraestructura de red: cableado, Wi-Fi, switching y enlaces con criterio de disponibilidad."
>
	<ServicePage
		eyebrow="Servicio experto"
		title="Infraestructura de red"
		lead="La red es la base silenciosa de la seguridad y del software. La diseñamos para disponibilidad: si cae el enlace, cae la operación."
		points={[
			{
				title: 'Disponibilidad primero',
				body: 'Cableado, switching y enlaces con criterio de continuidad. El diseño asume fallas y deja camino de recuperación.',
			},
			{
				title: 'Wi‑Fi que escala',
				body: 'Cobertura y densidad medidas para el sitio real — no para la ficha técnica. Menos celdas huérfanas, más control.',
			},
			{
				title: 'Base para el resto',
				body: 'Cámaras, control de acceso y plataformas corren sobre esta capa. Se diseña con ellos, no después de ellos.',
			},
			{
				title: 'Retorno en silencio',
				body: 'Una red bien hecha no se presume: evita cortes, retrabajos y compras de emergencia. El indicador es uptime.',
			},
		]}
	/>
</Layout>
