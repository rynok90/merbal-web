---
import About from '../components/About.astro';
import CtaBand from '../components/CtaBand.astro';
import Layout from '../layouts/Layout.astro';
import Method from '../components/Method.astro';
---

<Layout
	title="Nosotros — MERBAL Technologies"
	description="Cómo trabajamos: diagnóstico, diseño, implementación y acompañamiento. Empresa mexicana con criterio de ingeniería."
>
	<main>
		<section class="relative overflow-hidden bg-navy-950 pt-[4.25rem]">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_40%_at_50%_-10%,rgba(43,140,255,0.16),transparent_58%)]"
			>
			</div>
			<div class="relative mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
				<p class="hero-in mb-4 font-display text-xs font-medium uppercase tracking-[0.22em] text-accent">
					Nosotros
				</p>
				<h1 class="hero-in max-w-3xl font-display text-4xl font-semibold tracking-tight sm:text-5xl">
					Método y experiencia. Sin catálogo de entrada.
				</h1>
				<p class="hero-in mt-6 max-w-2xl text-base leading-relaxed text-text-soft sm:text-lg">
					MERBAL Technologies es una casa de plataformas. Productos propios y desarrollo a la medida
					para operar el sitio y el negocio: diagnóstico con cifra y arquitectura que se puede defender.
				</p>
			</div>
		</section>
		<Method />
		<About />
		<CtaBand />
	</main>
</Layout>
