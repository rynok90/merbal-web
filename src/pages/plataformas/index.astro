---
import Layout from '../../layouts/Layout.astro';
import Platforms from '../../components/Platforms.astro';

const title = 'Plataformas — MERBAL Technologies';
const description =
	'Desarrollamos el software. Integramos la tecnología. División de software, Seguridad electrónica e Infraestructura de red.';
---

<Layout title={title} description={description}>
	<main>
		<section class="relative overflow-hidden bg-navy-950 pt-[4.25rem]">
			<div
				class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_70%_45%_at_80%_0%,rgba(43,140,255,0.16),transparent_60%)]"
			>
			</div>
			<div class="relative mx-auto max-w-6xl px-5 py-16 sm:px-8 sm:py-24">
				<p class="hero-in mb-4 font-display text-xs font-medium uppercase tracking-[0.22em] text-accent">
					División de software
				</p>
				<h1 class="hero-in max-w-3xl font-display text-4xl font-semibold tracking-tight sm:text-5xl">
					Plataformas
				</h1>
				<p class="hero-in mt-6 max-w-2xl text-base leading-relaxed text-text-soft sm:text-lg">
					Desarrollamos el software. Integramos la tecnología.
				</p>
				<p class="hero-in mt-3 max-w-2xl text-base leading-relaxed text-text-soft sm:text-lg">
					<span class="text-accent whitespace-nowrap">División de software</span>,{' '}
					<span class="text-integration whitespace-nowrap">Seguridad electrónica</span>{' e '}
					<span class="text-integration whitespace-nowrap">Infraestructura de red</span>.
				</p>
			</div>
		</section>
		<Platforms />
	</main>
</Layout>
